---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"><title>Aidan Chen — Journal</title><subtitle>{{ site.description | xml_escape }}</subtitle><link href="{{ '/feed.xml' | absolute_url }}" rel="self"/><link href="{{ '/' | absolute_url }}"/><updated>{{ site.time | date_to_xmlschema }}</updated><id>{{ '/' | absolute_url }}</id><author><name>Aidan Chen</name></author>{% for post in site.posts %}<entry><title>{{ post.title | xml_escape }}</title><link href="{{ post.url | absolute_url }}"/><id>{{ post.url | absolute_url }}</id><published>{{ post.date | date_to_xmlschema }}</published><updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated><summary>{{ post.description | strip_html | xml_escape }}</summary></entry>{% endfor %}</feed>
